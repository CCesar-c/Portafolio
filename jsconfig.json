{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    ".vite",
    "src/assets/**/*",
    "src/images/**/*"
  ]
}
